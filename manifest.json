{
  "plugins": [
    {
      "manifest": {
        "plugin_id": "community.email-alerts",
        "version": "1.8.1",
        "checksum": "__CHECKSUM__",
        "silo_api_version": "v1",
        "supported_platforms": [
          {
            "os": "linux",
            "arch": "amd64"
          },
          {
            "os": "linux",
            "arch": "arm64"
          }
        ],
        "category": "Notifications",
        "capabilities": [
          {
            "type": "event_consumer.v1",
            "id": "new-media",
            "display_name": "New media listener",
            "description": "Wakes the mailer when a scan adds items to a library.",
            "subscriptions": [
              "library.item_added",
              "catalog.library.changed",
              "scan_complete"
            ]
          },
          {
            "type": "scheduled_task.v1",
            "id": "send-due",
            "display_name": "Email alerts: send due emails",
            "description": "Checks for new media and sends any instant alerts and digests that are due. Runs at startup; give it a 15-minute interval as a safety net."
          },
          {
            "type": "http_routes.v1",
            "id": "pages",
            "display_name": "Email alert pages",
            "description": "Template editor, recipient management and self-service sign-up."
          }
        ],
        "http_routes": [
          {
            "id": "admin-page",
            "method": "GET",
            "path": "/admin/",
            "access": "admin",
            "navigable": true,
            "navigation_label": "Email alerts",
            "navigation_kind": "admin"
          },
          {
            "id": "admin-api",
            "method": "*",
            "path": "/api/admin/*",
            "access": "admin"
          },
          {
            "id": "me-page",
            "method": "GET",
            "path": "/me/",
            "access": "authenticated",
            "navigable": true,
            "navigation_label": "Email alerts",
            "navigation_kind": "user"
          },
          {
            "id": "me-api",
            "method": "*",
            "path": "/api/me/*",
            "access": "authenticated"
          },
          {
            "id": "public",
            "method": "*",
            "path": "/public/*",
            "access": "public"
          }
        ],
        "global_config_schema": [
          {
            "key": "silo",
            "title": "Silo connection",
            "description": "An API key from an admin account, used to read new episodes and movies from the catalog.",
            "required": true,
            "json_schema": "{\"type\":\"object\",\"properties\":{\"api_key\":{\"type\":\"string\"},\"profile_id\":{\"type\":\"string\"},\"base_url\":{\"type\":\"string\"},\"public_url\":{\"type\":\"string\"},\"server_name\":{\"type\":\"string\"}},\"additionalProperties\":false}",
            "admin_form": {
              "fields": [
                {
                  "key": "api_key",
                  "label": "Admin API key",
                  "description": "Create one under Settings \u2192 API keys while signed in as an admin. Starts with sa_.",
                  "control": 3,
                  "secret": true,
                  "required": true
                },
                {
                  "key": "server_name",
                  "label": "Server name",
                  "description": "Shown in emails as {{server_name}}.",
                  "control": 1,
                  "placeholder": "Silo"
                },
                {
                  "key": "public_url",
                  "label": "Public URL override",
                  "description": "Used for Watch now and unsubscribe links. Leave empty to use SILO_PUBLIC_URL.",
                  "control": 1,
                  "placeholder": "https://silo.example.com"
                },
                {
                  "key": "profile_id",
                  "label": "Profile ID",
                  "description": "The profile the plugin reads the catalog as. Leave empty to use the key owner's primary profile. Use an unrestricted profile so nothing is hidden.",
                  "control": 1
                },
                {
                  "key": "base_url",
                  "label": "Internal API URL override",
                  "description": "Leave empty; the plugin asks Silo for its own listener.",
                  "control": 1,
                  "placeholder": "http://127.0.0.1:8080"
                }
              ],
              "sections": [
                {
                  "key": "main",
                  "title": "Connection",
                  "field_keys": [
                    "api_key",
                    "server_name",
                    "public_url"
                  ]
                },
                {
                  "key": "advanced",
                  "title": "Advanced",
                  "collapsible": true,
                  "collapsed_default": true,
                  "field_keys": [
                    "profile_id",
                    "base_url"
                  ]
                }
              ],
              "submit_label": "Save connection"
            }
          },
          {
            "key": "smtp",
            "title": "Outgoing mail (SMTP)",
            "description": "The mail server the alerts are sent through. You can reuse the details from Admin Settings \u2192 Notifications \u2192 Email.",
            "required": true,
            "json_schema": "{\"type\":\"object\",\"properties\":{\"host\":{\"type\":\"string\"},\"port\":{\"type\":\"number\"},\"security\":{\"type\":\"string\",\"enum\":[\"starttls\",\"tls\",\"none\"]},\"username\":{\"type\":\"string\"},\"password\":{\"type\":\"string\"},\"from_address\":{\"type\":\"string\"},\"from_name\":{\"type\":\"string\"},\"reply_to\":{\"type\":\"string\"}},\"additionalProperties\":false}",
            "admin_form": {
              "fields": [
                {
                  "key": "host",
                  "label": "SMTP host",
                  "control": 1,
                  "placeholder": "smtp.gmail.com",
                  "required": true
                },
                {
                  "key": "port",
                  "label": "Port",
                  "control": 4,
                  "default_value": 587,
                  "validation": {
                    "has_min": true,
                    "min": 1,
                    "has_max": true,
                    "max": 65535
                  }
                },
                {
                  "key": "security",
                  "label": "Security",
                  "control": 6,
                  "default_value": "starttls",
                  "options": [
                    {
                      "value": "starttls",
                      "label": "STARTTLS (port 587)"
                    },
                    {
                      "value": "tls",
                      "label": "TLS (port 465)"
                    },
                    {
                      "value": "none",
                      "label": "None"
                    }
                  ]
                },
                {
                  "key": "username",
                  "label": "Username",
                  "description": "Leave empty for no authentication.",
                  "control": 1
                },
                {
                  "key": "password",
                  "label": "Password",
                  "description": "For Gmail, use an app password.",
                  "control": 3,
                  "secret": true
                },
                {
                  "key": "from_address",
                  "label": "From address",
                  "control": 1,
                  "placeholder": "silo@example.com",
                  "required": true
                },
                {
                  "key": "from_name",
                  "label": "From name",
                  "control": 1,
                  "placeholder": "Silo"
                },
                {
                  "key": "reply_to",
                  "label": "Reply-to address",
                  "control": 1
                }
              ],
              "submit_label": "Save mail server"
            }
          }
        ],
        "presentation": {
          "display_name": "Email Alerts",
          "summary": "Email plugin for Silo that sends customisable rich emails for every new episode and movie on the server.",
          "description_markdown": "Sends an email when new episodes or movies arrive anywhere on the server, not just for series a profile follows.\n\n- Instant alerts, daily digests or weekly digests per recipient\n- Fully editable subject, HTML and plain-text templates with variables such as `{{show_name}}`, `{{episode_name}}` and `{{show_synopsis}}`\n- Posters and episode stills embedded in the email\n- Admin-managed recipients plus a self-service sign-up page for every user, with one-click unsubscribe",
          "setup_markdown": "1. Create an admin API key (Settings \u2192 API keys) and paste it into **Silo connection**.\n2. Fill in **Outgoing mail (SMTP)**.\n3. Open **Email alerts** in the admin menu to edit templates, add recipients and send a test.\n4. In Scheduled Tasks, give **Email alerts: send due emails** a 15-minute interval so digests go out even when no scan runs.",
          "publisher_name": "locky.uk",
          "license_spdx": "MIT",
          "homepage_url": "https://github.com/lockyuk/silo-plugins/tree/main/plugins/email-alerts",
          "source_url": "https://github.com/lockyuk/silo-plugins",
          "support_url": "https://github.com/lockyuk/silo-plugins/issues",
          "changelog_url": "https://github.com/lockyuk/silo-plugins/releases",
          "publisher_url": "https://github.com/lockyuk"
        }
      },
      "repo_url": "https://github.com/lockyuk/silo-plugins",
      "binaries": {
        "linux/amd64": {
          "url": "https://github.com/lockyuk/silo-plugins/releases/download/email-alerts-v1.8.1/email-alerts-1.8.1-linux-amd64",
          "checksum": "7662c98a9e98e9df572bf75689fef6efaa707344148c8fe58c497479041d9d2f"
        },
        "linux/arm64": {
          "url": "https://github.com/lockyuk/silo-plugins/releases/download/email-alerts-v1.8.1/email-alerts-1.8.1-linux-arm64",
          "checksum": "90fc7bb8f7e43f9214da442a529b285fc67e109508432aab34d7de793e90e1bf"
        }
      }
    },
    {
      "manifest": {
        "plugin_id": "community.google-auth",
        "version": "0.3.2",
        "checksum": "__CHECKSUM__",
        "silo_api_version": "v1",
        "supported_platforms": [
          {
            "os": "linux",
            "arch": "amd64"
          },
          {
            "os": "linux",
            "arch": "arm64"
          }
        ],
        "category": "Authentication",
        "capabilities": [
          {
            "type": "auth_provider.v1",
            "id": "google",
            "display_name": "Google",
            "auth_modes": [
              "oauth2"
            ],
            "metadata": {
              "connection_test": true
            }
          },
          {
            "type": "http_routes.v1",
            "id": "assets",
            "display_name": "Login button icon",
            "description": "Serves the Google icon for the sign-in button."
          }
        ],
        "http_routes": [
          {
            "id": "assets",
            "method": "GET",
            "path": "/assets/*",
            "access": "public"
          }
        ],
        "global_config_schema": [
          {
            "key": "google",
            "title": "Google OAuth client",
            "description": "Credentials from Google Cloud Console (APIs & Services > Credentials > OAuth client ID, type Web application). Anyone with an enabled Silo account may sign in with the Google address on their account; roles stay as set in Silo. Silo itself still links the Google identity to the account, automatically if Silo's email auto-match setting is on.",
            "required": true,
            "json_schema": "{\"type\":\"object\",\"properties\":{\"client_id\":{\"type\":\"string\"},\"client_secret\":{\"type\":\"string\"},\"prompt\":{\"type\":\"string\"},\"silo_api_key\":{\"type\":\"string\"}},\"additionalProperties\":false}",
            "admin_form": {
              "fields": [
                {
                  "key": "client_id",
                  "label": "Client ID",
                  "control": 1,
                  "required": true,
                  "placeholder": "123-abc.apps.googleusercontent.com"
                },
                {
                  "key": "client_secret",
                  "label": "Client secret",
                  "control": 3,
                  "secret": true,
                  "required": false,
                  "description": "Required for sign-in to work. Leave blank to keep the secret already saved; type a value only to replace it."
                },
                {
                  "key": "silo_api_key",
                  "label": "Silo API key",
                  "description": "How the plugin checks that a Google address belongs to an enabled Silo account. Create a key in Settings > API keys with the admin:monitor:read scope. Leave blank to keep the saved key.",
                  "control": 3,
                  "secret": true
                },
                {
                  "key": "prompt",
                  "label": "Default prompt",
                  "description": "Optional: select_account always shows the account chooser.",
                  "control": 1,
                  "placeholder": "select_account"
                }
              ],
              "sections": [
                {
                  "key": "main",
                  "title": "Google OAuth client",
                  "field_keys": [
                    "client_id",
                    "client_secret",
                    "silo_api_key",
                    "prompt"
                  ]
                }
              ],
              "submit_label": "Save Google settings"
            }
          },
          {
            "key": "display_name",
            "title": "Button label",
            "json_schema": "{\"type\":\"object\",\"properties\":{\"value\":{\"type\":\"string\"}},\"additionalProperties\":false}",
            "admin_form": {
              "fields": [
                {
                  "key": "value",
                  "label": "Label",
                  "control": 1,
                  "placeholder": "Google"
                }
              ],
              "sections": [
                {
                  "key": "main",
                  "title": "Button label",
                  "field_keys": [
                    "value"
                  ]
                }
              ],
              "submit_label": "Save"
            }
          },
          {
            "key": "icon_url_path",
            "title": "Button icon",
            "json_schema": "{\"type\":\"object\",\"properties\":{\"value\":{\"type\":\"string\"}},\"additionalProperties\":false}",
            "admin_form": {
              "fields": [
                {
                  "key": "value",
                  "label": "Icon path",
                  "control": 1,
                  "placeholder": "google.svg"
                }
              ],
              "sections": [
                {
                  "key": "main",
                  "title": "Button icon",
                  "field_keys": [
                    "value"
                  ]
                }
              ],
              "submit_label": "Save"
            }
          }
        ],
        "presentation": {
          "display_name": "Google Sign-In",
          "summary": "Sign in to Silo with a Google account.",
          "description_markdown": "Adds a **Sign in with Google** button. Anyone with an enabled Silo account can sign in with the Google address on their account; roles come from Silo.",
          "setup_markdown": "1. In Google Cloud Console create an OAuth client (Web application) and add the redirect URI shown by Silo.\n2. Create a Silo API key with the `admin:monitor:read` scope.\n3. Paste the client ID, client secret and Silo API key, then press Test connection.\n4. Optionally turn on Silo's email auto-match setting so first sign-ins link automatically.",
          "publisher_name": "locky.uk",
          "license_spdx": "MIT",
          "homepage_url": "https://github.com/lockyuk/silo-plugins/tree/main/plugins/google-auth",
          "source_url": "https://github.com/lockyuk/silo-plugins",
          "support_url": "https://github.com/lockyuk/silo-plugins/issues",
          "changelog_url": "https://github.com/lockyuk/silo-plugins/releases",
          "publisher_url": "https://github.com/lockyuk"
        }
      },
      "repo_url": "https://github.com/lockyuk/silo-plugins",
      "binaries": {
        "linux/amd64": {
          "url": "https://github.com/lockyuk/silo-plugins/releases/download/google-auth-v0.3.2/google-auth-0.3.2-linux-amd64",
          "checksum": "4bf07b670c265d52bfd31734140b3493772f7e5b826594ac823a515302fae9f6"
        },
        "linux/arm64": {
          "url": "https://github.com/lockyuk/silo-plugins/releases/download/google-auth-v0.3.2/google-auth-0.3.2-linux-arm64",
          "checksum": "b2409fc7280e052f723ea5ad2a4bdba8fa909ecd7eb0b31213e4cdc77a31d164"
        }
      }
    }
  ]
}
